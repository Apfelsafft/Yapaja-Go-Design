# Server configuration
PORT=8080
HOST=0.0.0.0

# Logging level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Valhalla routing service URL
# Used for route calculation and map data
VALHALLA_URL=http://valhalla:8002

# Photon search service URL
# Used for address search and geocoding
PHOTON_URL=http://photon:2322

# Photon JVM heap cap (docker-compose.yml JAVA_PARAMS=-Xmx${PHOTON_XMX}).
# docs/01 §4 Ressourcen-Budget: Photon (JVM, -Xmx) ≤ 1 GB (Default below).
# Lower it on RAM-constrained mini-PCs (e.g. 512m/256m for a small country
# index) -- see services/photon/README.md for guidance and the W-12
# shutdown-Photon-entirely option (falls back to the lite search index).
PHOTON_XMX=1g

# W-12: set to "false" to disable Photon entirely (e.g. very RAM-constrained
# mini-PC) -- search then falls back to the offline lite index (E05-T5,
# services/valhalla/build-lite-index.sh) automatically. Default: enabled.
#PHOTON_ENABLED=false
