{
  "name": "@yapaja/monorepo",
  "version": "0.0.1",
  "description": "Yapaja Go - Browser-based offline navigation app for motorhomes",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "build": "pnpm -r --filter='./apps/**' build",
    "dev": "pnpm -r --parallel dev",
    "e2e": "pnpm --filter @yapaja/web e2e",
    "golden-routes": "vitest run --config vitest.golden.config.ts",
    "golden-routes:provenance": "bash scripts/osm-restriction-provenance.sh",
    "runbook:smoke": "bash scripts/runbook-smoke.sh",
    "e2e:security": "playwright test -c e2e/security/playwright.config.ts",
    "audit:gate": "node scripts/dependency-audit.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "security:mutation-proof": "bash scripts/security-mutation-proof.sh",
    "perf": "playwright test -c e2e/perf/playwright.config.ts",
    "perf:soak": "PERF_SOAK=1 playwright test -c e2e/perf/playwright.config.ts -g \"Soak\"",
    "perf:degradation-proof": "bash scripts/perf-degradation-proof.sh",
    "openapi:generate": "pnpm --filter @yapaja/core run openapi:generate",
    "openapi:check": "pnpm --filter @yapaja/core run openapi:check",
    "wargame:check": "node scripts/wargame-coverage.mjs --check",
    "addon-compat:check": "pnpm --filter @yapaja/core exec tsx ../../scripts/addon-compat-check.ts --check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release:changelog-check": "node scripts/changeset-breaking-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.6.0",
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.6.0",
    "js-yaml": "^5.2.3",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "ws": "^8.18.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@^3.0.0": "^3.1.6",
      "fast-uri@^4.0.0": "^4.1.3"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
