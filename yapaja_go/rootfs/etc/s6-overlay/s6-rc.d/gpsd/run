#!/command/with-contenv bashio
# ==============================================================================
# gpsd -- s6-rc longrun (E08-T4, docs/04 §3 "USB-GPS: usb: true + udev; gpsd
# läuft im Add-on-Container"). Bridges a USB GPS receiver to the Core's
# `apps/core/src/position/gpsd/` client over TCP :2947 (127.0.0.1 only --
# never exposed outside the container).
#
# `GPS_SOURCE` (config.yaml option): "usb" -> look for a serial GPS device
# under /dev (passed through by config.yaml's `usb: true` + `udev: true`,
# which make the Supervisor forward USB device nodes + udev events into the
# container). "network" -> an external gpsd is expected to be reachable
# separately (documented in DOCS.md); this add-on's own gpsd doesn't need to
# run. "none" -> no GPS at all (simulator source only, e.g. for a first
# smoke-test of the add-on before wiring real hardware).
#
# WELCHES Gerät genommen wird, entscheidet `/etc/yapaja/find-gps-device.sh` --
# und zwar nicht mehr nach „das erste ttyACM*". Die Begründung steht dort.
# ==============================================================================
set -uo pipefail

if [ "${GPS_SOURCE}" != "usb" ]; then
  bashio::log.info "gpsd: GPS source is '${GPS_SOURCE}', not 'usb' -- this in-container gpsd is not needed, idling."
  exec sleep infinity
fi

# shellcheck source=/dev/null
source /etc/yapaja/find-gps-device.sh

# ─── DIE BEGRUENDUNG MUSS DORTHIN, WO HINGESEHEN WIRD ────────────────────────
# `find-gps-device.sh` bildet einen genauen Klartext: welches Geraet genommen
# wurde, oder warum keines. Der landete bisher nur im Add-on-Protokoll.
#
# In der Installationspruefung stand derweil bloss „gpsd ist eingeschaltet,
# antwortet aber nicht unter 127.0.0.1:2947" -- eine Beschreibung des
# Symptoms, gefolgt von einer Liste moeglicher Ursachen zum Durchprobieren.
# Gemeldet wurde genau daran: „Der VK-162 scheint aber korrekt erkannt zu
# werden. Gpsd aber nicht?" Die Antwort lag die ganze Zeit vor, eine Ebene
# tiefer, und war aus der Oberflaeche nicht zu erreichen.
#
# Deshalb hier eine Datei, die der Kern im selben Container liest. Sie liegt
# unter /run: ein Laufzeitzustand, der beim Neustart verschwinden SOLL --
# unter /share ueberlebte eine veraltete Begruendung den Neustart und waere
# schlimmer als gar keine.
#
# Erste Zeile: `suchend` oder `bereit`. Danach der Klartext.
STATUS_DATEI="${GPS_STATUS_DATEI:-/run/yapaja/gps-status}"
status_schreiben() {
  mkdir -p "$(dirname "${STATUS_DATEI}")" 2>/dev/null || return 0
  printf '%s\n%s\n' "$1" "$2" > "${STATUS_DATEI}" 2>/dev/null || true
}

# Alle 15 s neu sehen, statt abzustürzen: ein fehlender oder mehrdeutiger
# Empfänger ist kein Fehler des Add-ons. Der Fahrer soll Yapaia benutzen
# können, während der Dongle noch in der Post ist -- die Position fällt im
# Core auf die übrigen Quellen zurück, wie bei jedem anderen „kein GPS".
#
# Der Grund wird nur beim WECHSEL protokolliert. Sonst schriebe dieser Dienst
# alle 15 Sekunden dieselbe Zeile ins Add-on-Protokoll und machte es
# unbrauchbar für alles andere.
LETZTER_GRUND=""
while true; do
  # OHNE `$(...)`: die Funktion setzt zwei Variablen, und eine Subshell
  # wuerde beide wieder verwerfen (siehe find-gps-device.sh).
  if gps_device_waehlen; then
    DEVICE="${GPS_DEVICE_PFAD}"
    bashio::log.info "gpsd: benutze ${DEVICE} (${GPS_DEVICE_GRUND})."
    status_schreiben "bereit" "Empfänger ${DEVICE} — ${GPS_DEVICE_GRUND}"
    break
  fi

  # Geschrieben wird bei JEDEM Durchlauf, protokolliert nur beim Wechsel.
  # Die Datei ist ein Zustand, kein Ereignis: sie muss auch dann stimmen,
  # wenn die Prüfung erst eine Stunde später nachsieht.
  status_schreiben "suchend" "${GPS_DEVICE_GRUND}"

  if [ "${GPS_DEVICE_GRUND}" != "${LETZTER_GRUND}" ]; then
    bashio::log.warning "gpsd: kein Empfänger in Betrieb genommen -- ${GPS_DEVICE_GRUND} (siehe DOCS.md, Abschnitt 'USB-GPS'). Wird alle 15 s erneut geprüft; die Position fällt solange auf die übrigen Quellen zurück."
    LETZTER_GRUND="${GPS_DEVICE_GRUND}"
  fi
  sleep 15
done

# ─── GIBT ES gpsd UEBERHAUPT? ───────────────────────────────────────────────
# `exec` auf ein Programm, das nicht im PATH liegt, beendet dieses Skript mit
# 127. s6 startet den Dienst daraufhin neu, die Geraetesuche laeuft erneut und
# meldet wieder „benutze /dev/…" -- im Sekundentakt. Das Protokoll liest sich
# dann wie Erfolg, obwohl nie ein gpsd lief.
#
# Der Fall ist nicht erfunden: `osmium` hat in diesem Image schon einmal
# gefehlt, und der Suchindex-Bau brach auf dem Geraet ab, waehrend jede CI
# gruen war. gpsd stand bis 0.8.9 nicht in der Werkzeugpruefung der CI.
if ! command -v gpsd >/dev/null 2>&1; then
  GRUND="das Programm gpsd ist im Add-on-Image nicht auffindbar (PATH=${PATH})."
  bashio::log.error "gpsd: ${GRUND} Ohne gpsd gibt es keine USB-Position; die Position fällt auf die übrigen Quellen zurück."
  status_schreiben "fehler" "${GRUND}"
  # Nicht im Sekundentakt weiterversuchen: daran aendert sich bis zum
  # naechsten Update nichts, und ein Protokoll voller Wiederholungen
  # verdeckt alles andere.
  sleep "${GPSD_FEHLT_WARTE_S:-300}"
  exit 1
fi

# ─── DIE NEUSTARTSCHLEIFE ERKENNEN ──────────────────────────────────────────
# Stirbt gpsd sofort, sieht das Protokoll aus wie ein gesunder Dienst: jede
# Sekunde „benutze <Geraet>", und nirgends steht, dass danach etwas
# fehlgeschlagen ist. Genau so wurde es gemeldet.
#
# Deshalb eine Marke mit dem Zeitpunkt des letzten Starts. Liegt der weniger
# als ein paar Sekunden zurueck, lief gpsd nicht -- es ist gestorben.
START_MARKE="$(dirname "${STATUS_DATEI}")/gpsd-letzter-start"
JETZT="$(date +%s)"
VORHER="$(cat "${START_MARKE}" 2>/dev/null || echo 0)"
mkdir -p "$(dirname "${START_MARKE}")" 2>/dev/null || true
printf '%s' "${JETZT}" > "${START_MARKE}" 2>/dev/null || true

if [ "${VORHER}" != "0" ] && [ "$((JETZT - VORHER))" -lt "${GPSD_MIN_LAUFZEIT_S:-8}" ]; then
  GRUND="gpsd startet und beendet sich sofort wieder (Neustartschleife). Das Gerät ${DEVICE} wird gefunden, gpsd läuft trotzdem nicht — die Zeilen von gpsd selbst stehen darüber im Protokoll."
  bashio::log.error "gpsd: ${GRUND}"
  status_schreiben "fehler" "${GRUND}"
  # Abbremsen. Aus einer Meldung je Sekunde wird eine je halbe Minute, und
  # das Protokoll bleibt fuer alles andere brauchbar.
  sleep "${GPSD_BREMSE_S:-30}"
fi

# -N: foreground (required under s6 supervision -- no daemonizing/double-fork,
#     so SIGTERM from s6 on shutdown reaches this process directly).
# -n: don't wait for a client to connect before polling the device.
# -D 2: gpsd soll SAGEN, was es tut. Ohne das stirbt es stumm, und der einzige
#     Hinweis ist, dass dieses Skript eine Sekunde spaeter wieder anlaeuft.
# -G: listen on all configured addresses is NOT used here on purpose -- gpsd
#     defaults to localhost-only, which is exactly what we want (only the
#     Core, in the same container/network-namespace, talks to it).
#
# ─── WARUM KEIN `exec` MEHR ─────────────────────────────────────────────────
# `exec` ersetzt diese Shell durch gpsd. Stirbt gpsd, ist der Exit-Code weg --
# s6 startet neu, und niemand erfaehrt, WOMIT es gescheitert ist. Hier wird
# gpsd stattdessen im Hintergrund gestartet und auf ihn gewartet, damit der
# Code ins Protokoll kann.
#
# Die Signalweiterleitung, die `exec` geschenkt hatte, macht der `trap`: ohne
# ihn liefe gpsd beim Herunterfahren des Add-ons weiter, waehrend s6 nur diese
# Shell beendet.
gpsd -N -n -D 2 "${DEVICE}" &
GPSD_PID=$!
trap 'kill -TERM "${GPSD_PID}" 2>/dev/null || true' TERM INT
wait "${GPSD_PID}"
CODE=$?

bashio::log.error "gpsd: beendet mit Code ${CODE} (Gerät ${DEVICE}). s6 startet den Dienst neu."
status_schreiben "fehler" "gpsd hat sich mit Code ${CODE} beendet. Das Gerät ${DEVICE} wurde gefunden — es scheitert also nicht an der Gerätewahl, sondern an gpsd selbst."
exit "${CODE}"
