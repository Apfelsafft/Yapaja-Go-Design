#!/command/with-contenv bashio
# ==============================================================================
# gpsd -- s6-rc longrun (E08-T4, docs/04 §3 "USB-GPS: usb: true + udev; gpsd
# läuft im Add-on-Container"). Bridges a USB GPS receiver to the Core's
# `apps/core/src/position/gpsd/` client over TCP :2947 (127.0.0.1 only --
# never exposed outside the container).
#
# `GPS_SOURCE` (config.yaml option): "usb" -> look for a serial GPS device
# under /dev (passed through by config.yaml's `usb: true` + `udev: true`,
# which make the Supervisor forward USB device nodes + udev events into the
# container). "network" -> an external gpsd is expected to be reachable
# separately (documented in DOCS.md); this add-on's own gpsd doesn't need to
# run. "none" -> no GPS at all (simulator source only, e.g. for a first
# smoke-test of the add-on before wiring real hardware).
#
# WELCHES Gerät genommen wird, entscheidet `/etc/yapaja/find-gps-device.sh` --
# und zwar nicht mehr nach „das erste ttyACM*". Die Begründung steht dort.
# ==============================================================================
set -uo pipefail

if [ "${GPS_SOURCE}" != "usb" ]; then
  bashio::log.info "gpsd: GPS source is '${GPS_SOURCE}', not 'usb' -- this in-container gpsd is not needed, idling."
  exec sleep infinity
fi

# shellcheck source=/dev/null
source /etc/yapaja/find-gps-device.sh

# Alle 15 s neu sehen, statt abzustürzen: ein fehlender oder mehrdeutiger
# Empfänger ist kein Fehler des Add-ons. Der Fahrer soll Yapaia benutzen
# können, während der Dongle noch in der Post ist -- die Position fällt im
# Core auf die übrigen Quellen zurück, wie bei jedem anderen „kein GPS".
#
# Der Grund wird nur beim WECHSEL protokolliert. Sonst schriebe dieser Dienst
# alle 15 Sekunden dieselbe Zeile ins Add-on-Protokoll und machte es
# unbrauchbar für alles andere.
LETZTER_GRUND=""
while true; do
  # OHNE `$(...)`: die Funktion setzt zwei Variablen, und eine Subshell
  # wuerde beide wieder verwerfen (siehe find-gps-device.sh).
  if gps_device_waehlen; then
    DEVICE="${GPS_DEVICE_PFAD}"
    bashio::log.info "gpsd: benutze ${DEVICE} (${GPS_DEVICE_GRUND})."
    break
  fi

  if [ "${GPS_DEVICE_GRUND}" != "${LETZTER_GRUND}" ]; then
    bashio::log.warning "gpsd: kein Empfänger in Betrieb genommen -- ${GPS_DEVICE_GRUND} (siehe DOCS.md, Abschnitt 'USB-GPS'). Wird alle 15 s erneut geprüft; die Position fällt solange auf die übrigen Quellen zurück."
    LETZTER_GRUND="${GPS_DEVICE_GRUND}"
  fi
  sleep 15
done

# -N: foreground (required under s6 supervision -- no daemonizing/double-fork,
#     so SIGTERM from s6 on shutdown reaches this process directly).
# -n: don't wait for a client to connect before polling the device.
# -G: listen on all configured addresses is NOT used here on purpose -- gpsd
#     defaults to localhost-only, which is exactly what we want (only the
#     Core, in the same container/network-namespace, talks to it).
exec gpsd -N -n "${DEVICE}"
