<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deterministic GPS-simulator fixture (E02-T4): short urban route with
  several 90-degree turns, ~590 m total, near-constant slow-down at each
  corner (plausible city driving: 4-8 m/s / 14-29 km/h). Coordinates are a
  synthetic (non-real-street) path generated from bearing+distance legs from
  a fixed origin, chosen inside the PMTiles fixture bounds used by
  apps/core/src/map/__fixtures__/pmtiles-fixture.ts (lon 5.8..15.1,
  lat 47.2..55.1) so later map/E2E fixtures can reference the same region.
  Regenerate via the (uncommitted) scratch script if legs ever change; do
  not hand-edit coordinates.
-->
