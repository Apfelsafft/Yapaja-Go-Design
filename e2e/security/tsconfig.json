{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": "../..",
    "paths": {
      "@yapaia/shared": ["packages/shared/src"],
      "@yapaia/ui": ["packages/ui/src"],
      "@yapaia/addon-sdk": ["packages/addon-sdk/src"]
    }
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["node_modules", ".tmp"]
}
